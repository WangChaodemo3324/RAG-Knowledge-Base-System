TAVILY_API_KEY=your_tavily_api_key
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_FALLBACK=duckduckgo
WEB_SEARCH_REQUIRE_TAVILY=false
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_DEPTH=basic
WEB_SEARCH_INCLUDE_RAW_CONTENT=false
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_TAVILY_MAX_RETRIES=2

# DeepSeek（问答必需）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# PostgreSQL + pgvector（docker compose 会读取同目录 .env）
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me_in_real_deployment
POSTGRES_DB=rag
POSTGRES_HOST_PORT=5433
RAG_DATABASE_URL=postgresql+psycopg://rag:change_me_in_real_deployment@127.0.0.1:5433/rag

# 管理端点（上传/重建/清记忆）认证；留空表示不启用
RAG_ADMIN_API_KEY=
